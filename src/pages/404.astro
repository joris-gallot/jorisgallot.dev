---
import Layout from '@layouts/Layout.astro'
---

<Layout title="Page not found" robots="noindex">
  <p class="text-bright">
    <span class="text-dim" aria-hidden="true">joris@dev:~$</span>{' '}
    cd {'<requested-page>'}
  </p>
  <div class="term-out mt-3">
    <h1 class="font-normal text-red">bash: cd: no such file or directory</h1>
    <p class="mt-3">
      <a href="/" class="text-blue hover:underline">← cd ~</a>
    </p>
  </div>
</Layout>
