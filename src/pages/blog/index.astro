---
import Cmd from '@components/Cmd.astro'
import TermRow from '@components/TermRow.astro'
import { BLOG } from '@consts'
import Layout from '@layouts/Layout.astro'
import { isoDate } from '@lib/date'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout title={BLOG.title} description={BLOG.description}>
  <p><a href="/" class="text-dim hover:text-blue hover:underline">← cd ~</a></p>
  <Cmd cmd="ls -t writing/" heading />
  <div class="term-out seq-out" style="--seq: 0">
    {posts.map(post => (
      <TermRow
        href={`/blog/${post.id}`}
        title={post.data.title}
        description={post.data.description}
        meta={isoDate(post.data.date)}
      />
    ))}
  </div>
</Layout>
