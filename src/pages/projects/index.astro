---
import Cmd from '@components/Cmd.astro'
import TermRow from '@components/TermRow.astro'
import { PROJECTS } from '@consts'
import Layout from '@layouts/Layout.astro'
import { isoDate } from '@lib/date'
import { getCollection } from 'astro:content'

const projects = (await getCollection('projects'))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout title={PROJECTS.title} description={PROJECTS.description}>
  <p><a href="/" class="text-dim hover:text-blue hover:underline">← cd ~</a></p>
  <Cmd cmd="ls -t open-source/" heading />
  <div class="term-out seq-out" style="--seq: 0">
    {projects.map(project => (
      <TermRow
        href={`/projects/${project.id}`}
        title={project.data.title}
        description={project.data.description}
        meta={isoDate(project.data.date)}
      />
    ))}
  </div>
</Layout>
