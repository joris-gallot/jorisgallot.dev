---
import type { Product } from '@types'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Props = {
  product: Product
}

const { product } = Astro.props

const shots = import.meta.glob<{ default: ImageMetadata }>('/src/images/products/*.png', { eager: true })
const light = shots[`/src/images/products/${product.key}-light.png`]?.default
const dark = shots[`/src/images/products/${product.key}-dark.png`]?.default
---

<article class="rounded-lg border border-black/15 dark:border-white/20 overflow-hidden">
  {light && dark && (
    <div class="border-b border-black/10 dark:border-white/15 bg-black/[0.02] dark:bg-white/[0.02]">
      <Image
        src={light}
        alt={`${product.name} screenshot`}
        widths={[640, 960]}
        sizes="(min-width: 640px) 600px, 100vw"
        class="block dark:hidden w-full aspect-[16/8] object-cover object-left-top"
        loading="lazy"
      />
      <Image
        src={dark}
        alt={`${product.name} screenshot`}
        widths={[640, 960]}
        sizes="(min-width: 640px) 600px, 100vw"
        class="hidden dark:block w-full aspect-[16/8] object-cover object-left-top"
        loading="lazy"
      />
    </div>
  )}

  <div class="flex flex-col gap-3 p-4">
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={product.href}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-black dark:text-white hover:underline underline-offset-2"
      >
        {product.name}
      </a>
      {product.note && (
        <span class="text-xs px-1.5 py-0.5 rounded-full border border-black/15 dark:border-white/20 opacity-80">
          {product.note}
        </span>
      )}
    </div>

    <p class="text-sm text-gray-700 dark:text-white/90">
      {product.tagline}
    </p>

    <div class="flex flex-wrap gap-1.5">
      {product.tags.map(tag => (
        <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <a href={product.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-black dark:hover:text-white">
        Visit
      </a>
      <a href={product.repoURL} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-black dark:hover:text-white">
        GitHub
      </a>
      {product.demoURL && (
        <a href={product.demoURL} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-black dark:hover:text-white">
          Live demo
        </a>
      )}
      <span class="text-xs opacity-60" title="Functional Source License">
        Source available
      </span>
    </div>
  </div>
</article>
