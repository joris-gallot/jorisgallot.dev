---
import Cmd from '@components/Cmd.astro'
import { SITE } from '@consts'
import Layout from '@layouts/Layout.astro'
import { isoDate } from '@lib/date'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter(post => !post.data.draft)

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': post.data.title,
  'description': post.data.description,
  'datePublished': post.data.date.toISOString(),
  'author': { '@type': 'Person', 'name': SITE.name, 'url': Astro.site?.toString() },
}
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  structuredData={structuredData}
>
  <p><a href="/#writing" class="text-dim hover:text-blue hover:underline">← cd ~</a></p>
  <Cmd cmd={`cat writing/${post.id}.md`} />
  <div class="term-out seq-out" style="--seq: 0">
    <h1 class="text-xl font-medium text-bright">
      <span class="text-blue" aria-hidden="true">#</span>{' '}
      {post.data.title}
    </h1>
    <p class="mt-1 text-dim">{post.data.description}</p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
      <time datetime={post.data.date.toISOString()} class="text-dim">{isoDate(post.data.date)}</time>
      {post.data.repoURL && (
        <a
          href={post.data.repoURL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue hover:underline"
          data-umami-event={`post-${post.id}-repo`}
        >
          [src]
        </a>
      )}
    </p>
    <hr class="my-6 border-line" />
    <div class="prose-term">
      <Content />
    </div>
  </div>
</Layout>
