---
interface Props {
  cmd: string
  id?: string
  heading?: boolean
  index?: number
}

const { cmd, id, heading = false, index = 0 } = Astro.props
const Tag = heading ? 'h2' : 'p'
---

<Tag id={id} class="seq-cmd mb-3 mt-10 scroll-mt-6 font-normal text-bright first:mt-0" style={`--seq: ${index}`}>
  <span class="text-dim" aria-hidden="true">joris@dev:~$</span>{' '}
  <span class="cmd-type">{cmd}</span>
</Tag>
