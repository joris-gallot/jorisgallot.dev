---
import Cmd from '@components/Cmd.astro'
import Layout from '@layouts/Layout.astro'
import { isoDate } from '@lib/date'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const projects = (await getCollection('projects'))
    .filter(project => !project.data.draft)

  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  'name': project.data.title,
  'description': project.data.description,
  'codeRepository': project.data.repoURL,
  'author': { '@type': 'Person', 'name': 'Joris Gallot' },
}
---

<Layout
  title={project.data.title}
  description={project.data.description}
  type="article"
  structuredData={structuredData}
>
  <p><a href="/#open-source" class="text-dim hover:text-blue hover:underline">← cd ~</a></p>
  <Cmd cmd={`cat open-source/${project.id}.md`} />
  <div class="term-out seq-out" style="--seq: 0">
    <h1 class="text-xl font-medium text-bright">
      <span class="text-blue" aria-hidden="true">#</span>
      {project.data.title}
    </h1>
    <p class="mt-1 text-dim">{project.data.description}</p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
      <time datetime={project.data.date.toISOString()} class="text-dim">{isoDate(project.data.date)}</time>
      {project.data.repoURL && (
        <a
          href={project.data.repoURL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue hover:underline"
          data-umami-event={`project-${project.id}-repo`}
        >
          [src]
        </a>
      )}
      {project.data.demoURL && (
        <a
          href={project.data.demoURL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue hover:underline"
          data-umami-event={`project-${project.id}-demo`}
        >
          [demo]
        </a>
      )}
    </p>
    <hr class="my-6 border-line" />
    <div class="prose-term">
      <Content />
    </div>
  </div>
</Layout>
